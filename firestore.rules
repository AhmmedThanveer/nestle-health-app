rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Events ───────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid;

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.points >= resource.data.get('points', 0)
                    && request.resource.data.scannedStations
                        .hasAll(resource.data.get('scannedStations', []));

      allow delete: if false;
    }

    // ── NSM Days ─────────────────────────────────────────────────────────────
    match /nsm_days/{dayId} {
      allow read: if true;
      allow write: if false;

      match /waves/{waveId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ── Stations ──────────────────────────────────────────────────────────────
    match /stations/{stationId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Registrations ────────────────────────────────────────────────────────
    match /registrations/{registrationId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Speakers ─────────────────────────────────────────────────────────────
    match /speakers/{speakerId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Agenda ───────────────────────────────────────────────────────────────
    match /agenda/{agendaId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Surveys ───────────────────────────────────────────────────────────────
    match /surveys/{surveyId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Polls (Live Voting) ───────────────────────────────────────────────────
    // Authenticated attendees can read active polls and submit votes.
    // Only the vote counts (options array) may be updated — question and
    // isActive fields are admin-managed and must not change via client writes.
    match /polls/{pollId} {
      allow read: if request.auth != null;

      allow update: if request.auth != null
                    && request.resource.data.isActive == resource.data.isActive
                    && request.resource.data.question == resource.data.question;

      allow create, delete: if false;
    }

    // ── Asset Folders (Downloads) ─────────────────────────────────────────────
    match /asset_folders/{folderId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Media (Photos & Videos) ───────────────────────────────────────────────
    match /media/{mediaId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
